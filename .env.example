# Copy to .env for `aio app run` / `aio app deploy`. Never commit .env.

# --- Adobe I/O / App Builder ---
AIO_runtime_namespace=
AIO_runtime_auth=
SERVICE_API_KEY=

# --- App behavior ---
# aio = durable @adobe/aio-lib-state (real runtime). Unset/anything else = in-memory (harness).
FANOUT_STORE=aio

# Branch dispatch: async = invoke each branch as its own I/O Runtime activation
# (production). direct = run branches in-process (local harness/dashboard).
DISPATCH_MODE=async
FANOUT_PACKAGE=toyota-assets-fanout

# Optional Scene7 Mixed Media Set branch. Leave empty to skip the integration.
S7_SERVER=
S7_COMPANY_HANDLE=
S7_USER=
S7_PASSWORD=
S7_SOURCE_IMAGE_FOLDER_PATH=
S7_SET_SEARCH_FOLDER_PATH=
S7_SET_FOLDER_PATH=

# Retry / DLQ policy (per branch)
BRANCH_MAX_ATTEMPTS=3
BRANCH_BASE_BACKOFF_MS=200

# Observability: an asset not READY_FOR_VIA after this long is flagged "stuck".
STUCK_AFTER_MS=300000
